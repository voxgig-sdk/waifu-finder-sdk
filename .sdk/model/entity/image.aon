# Entity: image

main: kit: entity: image: {

  alias: field: {}

  fields: [
    {
      name: "artist"
      req: false
      short: "Artist who created the image"
      type: "`$STRING`"
    }
    {
      name: "height"
      req: false
      short: "Image height in pixels"
      type: "`$INTEGER`"
    }
    {
      name: "id"
      req: false
      short: "Unique identifier for the image"
      type: "`$STRING`"
    }
    {
      name: "rating"
      req: false
      short: "Content rating of the image"
      type: "`$STRING`"
    }
    {
      name: "source"
      req: false
      short: "Original source of the image"
      type: "`$STRING`"
    }
    {
      name: "tags"
      req: false
      short: "Tags associated with the image"
      type: "`$ARRAY`"
    }
    {
      format: "uri"
      name: "thumbnail"
      req: false
      short: "Thumbnail image URL"
      type: "`$STRING`"
    }
    {
      format: "uri"
      name: "url"
      req: false
      short: "Full-size image URL"
      type: "`$STRING`"
    }
    {
      name: "width"
      req: false
      short: "Image width in pixels"
      type: "`$INTEGER`"
    }
  ]

  id: {
    field: "id"
    name: "id"
  }

  name: "image"
  op: {
    list: {
      name: "list"
      points: [
        {
          args: {
            query: [
              {
                example: 10
                kind: "query"
                name: "limit"
                orig: "limit"
                reqd: false
                type: "`$INTEGER`"
              }
              {
                example: "explicit"
                kind: "query"
                name: "rating"
                orig: "rating"
                reqd: false
                type: "`$STRING`"
              }
            ]
          }
          method: "GET"
          orig: "/images/random"
          segments: [
            {
              lit: "images"
            }
            {
              lit: "random"
            }
          ]
          select: {
            "$action": "random"
            exist: [
              "limit"
              "rating"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }



}
